{
  "name": "maeum-seed-storybook",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hub": "tsc -b && vite build --base=/heungbu-nolbu/ --outDir .hub-dist --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "qa": "vitest run && tsc -b --pretty false && vite build",
    "tts:plan": "node scripts/generate-tts.mjs plan",
    "tts:generate": "node scripts/generate-tts.mjs generate"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
