{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/heungbu-nolbu",
      "has": [
        {
          "type": "host",
          "value": "steal-bomb-game.vercel.app"
        }
      ],
      "destination": "https://taeu0102-ai.vercel.app/interactive-story/",
      "permanent": true
    },
    {
      "source": "/heungbu-nolbu/:path*",
      "has": [
        {
          "type": "host",
          "value": "steal-bomb-game.vercel.app"
        }
      ],
      "destination": "https://taeu0102-ai.vercel.app/interactive-story/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "steal-bomb-game.vercel.app"
        }
      ],
      "destination": "https://taeu0102-ai.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/heungbu-nolbu",
      "destination": "/interactive-story/",
      "permanent": true
    },
    {
      "source": "/heungbu-nolbu/:path*",
      "destination": "/interactive-story/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
